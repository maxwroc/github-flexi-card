{
    "compilerOptions": {
        "rootDir": "src",
        "target": "ES2018",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "alwaysStrict": true,
        "noImplicitAny": true,
        "strictNullChecks": true,
        "noImplicitThis": true,
        "strictPropertyInitialization": false,
        "strict": true
    }
}